{
  "$schema": "./qcopilots_service.schema.json",
  "service_id": "qcopilots.mcp_server_web_search",
  "plugin_name": "QCopilots MCP Server Web Search",
  "display_name": "QCopilots MCP Server Web Search",
  "description": "提供网页搜索、网页阅读和页内查找能力，通过标准 MCP 转接连接独立运行的 QCopilots-WebSearch 公网服务。适合 QCopilots 或其它 MCP 客户端使用页面配置的业务 Bearer，由 QCopilots MCP Servers Manager 管理本地转接进程，不负责启动或停止远端服务。",
  "entry_point": "server.py",
  "host": "127.0.0.1",
  "advertised_host": "127.0.0.1",
  "default_port": 48218,
  "mcp_path": "/mcp",
  "category": "qcopilots",
  "authorization_mode": "request",
  "capabilities": [
    "tools"
  ],
  "runtime": {
    "type": "uv",
    "requirements": "requirements.lock"
  },
  "cors_origins": []
}
