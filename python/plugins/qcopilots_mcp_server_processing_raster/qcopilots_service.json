{
  "$schema": "./qcopilots_service.schema.json",
  "service_id": "qcopilots.mcp_server_processing_raster",
  "plugin_name": "QCopilots MCP Server Processing Raster",
  "display_name": "QCopilots MCP Server Processing Raster",
  "description": "通过 QGIS bridge 将 QGIS Processing 中的栅格算法暴露为 MCP 工具，覆盖 DEM、栅格计算、重采样、格式转换和栅格分析等处理流程。算法通过异步作业执行，成功输出默认添加到当前工程。已有输出不会静默覆盖，覆盖需要显式请求和一次性确认令牌。服务依赖当前 QGIS Processing 环境、可用 provider 和本机数据访问权限。",
  "entry_point": "server.py",
  "host": "127.0.0.1",
  "advertised_host": "127.0.0.1",
  "default_port": 48215,
  "mcp_path": "/mcp",
  "category": "qcopilots",
  "capabilities": [
    "tools",
    "qgis-bridge",
    "processing",
    "raster"
  ],
  "runtime": {
    "type": "uv",
    "requirements": "requirements.lock"
  },
  "cors_origins": []
}
